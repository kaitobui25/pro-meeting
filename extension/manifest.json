{
  "manifest_version": 3,
  "name": "Pro Meeting ChatGPT Bridge",
  "version": "0.1.0",
  "description": "Sends Pro Meeting audio to a signed-in ChatGPT tab in your existing Chrome profile.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8796/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Pro Meeting Bridge" }
}
